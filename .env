# The API this portal talks to. Vite proxies /api to it in development, so the
# browser sees one origin and the HttpOnly refresh cookie is sent without any
# cross-origin credentials handling.
VITE_API_TARGET=https://sship-api.indic-ai.org
# Must match API_VERSION on the server.
VITE_API_VERSION=v1
# --- Firebase phone sign-in ---------------------------------------------------
#
# Public by design: a Firebase web apiKey identifies the project, it does not
# authorise anything. Phone auth is gated by the project's authorised-domain
# list and by reCAPTCHA, both enforced by Google.
#
# Project scholarship-adb48 belongs to this platform alone. It replaced
# settle-beta, which was shared with another product and therefore shared its
# SMS quota, its billing and its reCAPTCHA settings.

VITE_FIREBASE_API_KEY=AIzaSyBdbqAzSmbnASE8tPhLjEWTzylbbQmyiEw
VITE_FIREBASE_AUTH_DOMAIN=scholarship-adb48.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=scholarship-adb48
VITE_FIREBASE_STORAGE_BUCKET=scholarship-adb48.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=124472674172
VITE_FIREBASE_APP_ID=1:124472674172:web:9b2f96ea44911639dec6f9
