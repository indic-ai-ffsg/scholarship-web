# The API this portal talks to. Vite proxies /api to it in development, so the
# browser sees one origin and the HttpOnly refresh cookie is sent without any
# cross-origin credentials handling.
VITE_API_TARGET=https://sship-api.indic-ai.org
# Must match API_VERSION on the server.
VITE_API_VERSION=v1

# Mobile sign-in — MSG91's OTP widget.
#
# Public by design: this id identifies the widget and authorises it to send a
# code, nothing more. It is committed on purpose, because CI builds the image
# from this file. The MSG91 *authkey* is a different value, lives on the API's
# Railway service, and must never be given a VITE_ prefix — anything named VITE_
# is compiled into a file served to every visitor.
#
# Dashboard → OTP → the widget → its "Widget ID". The domain serving this app
# must also be listed against that widget, or initialisation fails in the
# browser.
#
# Empty is a working build with sign-in switched off: every public page loads
# and the sign-in screen says plainly that it is not set up. That sentence is
# what appears when this line is blank.
VITE_MSG91_WIDGET_ID=
# Optional; MSG91's script takes it alongside the widget id. If the widget will
# not initialise, this is the first thing to add.
VITE_MSG91_TOKEN_AUTH=
