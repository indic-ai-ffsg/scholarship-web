# Copy to .env. Both the Vite dev server and docker compose read that file, and
# neither is committed — see .gitignore.
#
# The names are split by who reads them: VITE_* are build-time settings, baked
# into the bundle or used by the dev server's proxy. The rest are read by
# docker-compose.yml and by the container at start-up.

# --- development (npm run dev / npm run preview) ------------------------------

# The API this portal talks to. Vite proxies /api to it in development, so the
# browser sees one origin and the HttpOnly refresh cookie is sent without any
# cross-origin credentials handling.
VITE_API_TARGET=http://localhost:8080

# Must match API_VERSION on the server. The portal builds every request path
# from this, so pointing at a v2 backend is a one-line change.
#
# Only ever set this to a version the server actually serves: it is compiled
# into the bundle, and a mismatch makes every request a 404 that nothing in the
# portal can explain.
VITE_API_VERSION=v1

# --- MSG91 phone sign-in ------------------------------------------------------
#
# Students sign in with a mobile number and a code MSG91 sends to it, and this
# app needs NO configuration for that. The exchange runs through the API: the
# portal posts a number to /auth/phone/send and later a code to /auth/phone, and
# nothing about the provider reaches the browser.
#
# It was two VITE_ values until recently, for a widget that ran in the page. A
# deployment that forgot them had a sign-in screen which took a number and then
# did nothing — no code, no second step, and no way for a student to tell why.
# The provider now lives entirely on the server, which always has its own
# configuration, and MSG91_AUTHKEY there is the only value involved.

# --- the container (docker compose) -------------------------------------------

# Where the API is, for the nginx inside the image: scheme://host[:port]. This
# is the deployed equivalent of VITE_API_TARGET above, and it is read at
# start-up rather than baked in — the same image serves any environment. A
# trailing slash is stripped; a missing scheme is refused with a message rather
# than a broken proxy; anything after the host is prefixed to every proxied
# path, which is right for an API mounted under a path and wrong otherwise, and
# is logged.
#
# The default is the API's compose service name, which only resolves when this
# container shares a network with it.
#API_TARGET=http://localhost:8080

# The build argument for VITE_API_VERSION when compose builds the image, kept
# under the server's own name because it is the server's version.
#API_VERSION=v1

# The image to run. Deploy a commit tag rather than :latest — it names exactly
# one build, and CI pushes both.
#WEB_IMAGE=indicsign/sp-web:latest

# Where the portal is published on the host. Loopback by default: the API sets
# the refresh cookie Secure in production, so the portal has to be served over
# HTTPS, which means something terminating TLS in front of this container.
# The MSG91 widget also refuses to initialise on an origin that is not listed
# against it in the dashboard, which a bare host:port over HTTP will not be.
#WEB_BIND=127.0.0.1
#WEB_PORT=5173

# Who resolves API_TARGET. Unset, the container uses its own nameservers, which
# is Docker's embedded DNS on a compose network and the platform's resolver
# anywhere else — set this only to override that.
#DNS_RESOLVER=127.0.0.11

# The port nginx serves on inside the container. Container platforms that assign
# a port set PORT themselves and the image follows it; LISTEN_PORT overrides
# both. Under compose neither is needed: the port mapping above publishes the
# default 80.
#LISTEN_PORT=80

# Set empty to stop the container listening on IPv6. Only needed where the
# kernel reports IPv6 but has it administratively disabled, which fails the bind
# and stops nginx from starting at all.
#LISTEN_IPV6=
